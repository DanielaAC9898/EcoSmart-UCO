    {
        "id": "6234e648df601434",
        "type": "function",
        "z": "407d4ca9db915b85",
        "name": "InsertarDB",
        "func": "// 1. Asegurar que msg.payload sea un objeto JavaScript\nlet data = msg.payload;\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.error(\"Error al procesar el JSON: \" + e.message, msg);\n        return null;\n    }\n}\n\n// 2. Validar si la propiedad 'mac' coincide con la MAC autorizada\nconst MAC_AUTORIZADA = \"e6:61:18:c4:17:86:7e:21\";\n\nif (!data.mac || data.mac !== MAC_AUTORIZADA) {\n    node.warn(\"Se esta intentando ingresar un nodo que no es autorizado. MAC recibida: \" + data.mac);\n    return null; // Cancela el flujo y no inserta en la base de datos\n}\n\n// 3. Consulta SQL usando la función NOW() de MySQL/MariaDB para la fecha\nmsg.topic = \"INSERT INTO valores (nodo_id, estado, mensaje_id, distancia, fecha) VALUES (?, ?, ?, ?, NOW());\";\n\n// 4. Arreglo con los parámetros mapeados desde el JSON\nmsg.payload = [\n    data.nodo_Id,\n    data.estado,\n    data.msg_id,\n    data.distancia_cm\n];\n\nreturn msg;",
